# Application Settings
APP_NAME=The Discoverer
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_BASE_URL=http://localhost:8000

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_SCHEMAS=schemas
QDRANT_COLLECTION_CONTENT=content
QDRANT_CLIENT_TIMEOUT=5.0

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MODEL_COMPLEX=gpt-4
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=1000

# Perplexity Configuration (if using Perplexity)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar
PERPLEXITY_MODEL_COMPLEX=sonar-pro
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=600

# Database Connection Pool
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_MAX_QUERIES=50000
DB_QUERY_TIMEOUT=5
POOL_DEFAULT_TIMEOUT=30.0

# Performance Settings
MAX_CONCURRENT_QUERIES=10
VECTOR_SEARCH_LIMIT=20
VECTOR_SEARCH_THRESHOLD=0.7
BATCH_EMBEDDING_SIZE=100

# Security
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Query History
QUERY_HISTORY_MAX_SIZE=1000

# Health Monitoring
HEALTH_CHECK_INTERVAL=30

# Scheduler
SCHEDULER_CHECK_INTERVAL=60
SCHEDULED_EXPORT_CHECK_INTERVAL=60

# Webhooks
WEBHOOK_TIMEOUT=30.0
WEBHOOK_MAX_RETRIES=3

# Export Storage
EXPORT_STORAGE_PATH=/tmp/exports

# HTTP Client Defaults
HTTP_CLIENT_TIMEOUT=30.0
HTTP_CLIENT_CONNECT_TIMEOUT=5.0

# CLI Defaults
CLI_TIMEOUT=60.0
CLI_HEALTH_CHECK_TIMEOUT=5.0
